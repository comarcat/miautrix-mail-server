<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <RootNamespace>Miautrix.Mail.Worker</RootNamespace>
    <AssemblyName>Miautrix.Mail.Worker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- One dispatch pass is internal so the integration tests can drive it directly rather
         than waiting on the 15s poll interval. -->
    <InternalsVisibleTo Include="Miautrix.Mail.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Miautrix.Mail.Domain\Miautrix.Mail.Domain.csproj" />
    <ProjectReference Include="..\Miautrix.Mail.Application\Miautrix.Mail.Application.csproj" />
    <ProjectReference Include="..\Miautrix.Mail.Infrastructure\Miautrix.Mail.Infrastructure.csproj" />
    <ProjectReference Include="..\Miautrix.Mail.Persistence\Miautrix.Mail.Persistence.csproj" />
    <ProjectReference Include="..\Miautrix.Mail.Identity\Miautrix.Mail.Identity.csproj" />
    <ProjectReference Include="..\Miautrix.Mail.Protocols.Smtp\Miautrix.Mail.Protocols.Smtp.csproj" />
    <ProjectReference Include="..\Miautrix.Mail.Protocols.Imap\Miautrix.Mail.Protocols.Imap.csproj" />
    <ProjectReference Include="..\Miautrix.Mail.Queue\Miautrix.Mail.Queue.csproj" />
    <ProjectReference Include="..\Miautrix.Mail.AntiSpam\Miautrix.Mail.AntiSpam.csproj" />
    <ProjectReference Include="..\Miautrix.Mail.Storage\Miautrix.Mail.Storage.csproj" />
  </ItemGroup>

</Project>

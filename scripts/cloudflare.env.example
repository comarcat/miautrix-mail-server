# Cloudflare transport credentials — TEMPLATE, placeholders only.
#
# Copy to cloudflare.env (git-ignored), fill in the real values, then deploy with:
#
#   ./scripts/deploy-compile-upload.ps1 -WorkerCert <cert.pem> -WorkerKey <key.pem> `
#       -DbConnectionFile <db.txt> -CloudflareEnvFile scripts/cloudflare.env
#
# lxc-install-worker-env.sh reads this file by path and rejects any key it does not
# recognise, so a typo fails the deploy instead of silently disarming the integration.
# The values are never passed on the command line, because argv is world-readable via ps
# and is captured in shell history.
#
# These are server-wide settings. The per-domain Worker URL and Zone ID are NOT here —
# they are configured per domain in the admin console and stored in the database.

# Cloudflare API token with permission to use the Email Routing / Email Service API.
# Without it, outbound Cloudflare transport stays disabled (receiving is unaffected).
CLOUDFLARE_API_TOKEN=replace-with-a-scoped-api-token

# Optional. Defaults to https://api.cloudflare.com/client/v4 when omitted.
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4

# Shared secret the Worker presents to POST /api/v1/inbound/cloudflare.
# Generate with: openssl rand -hex 32
# When absent the inbound webhook rejects every request (503) rather than trusting callers.
MIAUTRIX_INBOUND_TOKEN=replace-with-a-random-64-hex-character-secret

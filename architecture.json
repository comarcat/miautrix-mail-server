  "cards": [
    {
      "dot": "emerald",
      "title": "Clean Architecture & Modular Monolith",
      "items": [
        "Single deployable process on Debian Linux with .NET 10 and PostgreSQL 17",
        "Domain layer depends on nothing; Application depends only on Domain",
        "One authorization helper: all cross-tenant access returns 404 to prevent ID enumeration"
      ]
    },
    {
      "dot": "cyan",
      "title": "Mail Transport, Policy & Seams",
      "items": [
        "SMTP in/out with durable queue, exponential backoff retries, and DKIM signing",
        "Pluggable provider seams: ISpamProvider, IMalwareProvider (ClamAV), IMailStorage",
        "Full-text search indexed in PostgreSQL FTS; ManageSieve with syntax-checking gate"
      ]
    },
    {
      "dot": "rose",
      "title": "Security, Operations & Licensing",
      "items": [
        "Self-hosted identity with Argon2id, TOTP, and WebAuthn (Fido2 4.0.1)",
        "Fail-open licensing: mail keeps flowing if server is unreachable; over-limit blocks new mailboxes only",
        "Zero-downtime blue/green deployments with EXPAND → MIGRATE → CONTRACT migrations"
      ]
    }
  ]
